 "assumptions": [
  {
   "text": "Linear dose-response between emissions and AQI",
   "rationale": "Simplification appropriate for policy-level modelling."
  },
  {
   "text": "Indoor air quality is out of scope"
  },
  {
   "text": "Polarity is uniformly negative at city-annual scale",
   "target": "Vehicle Emissions -> Air Quality Index",
   "rationale": "Simplification; spatial heterogeneity noted as caveat."
  },
  {
   "text": "Atmospheric dispersion follows Gaussian plume behaviour.",
   "target": "Atmospheric Dispersion",
   "rationale": "Standard assumption in regulatory air quality modelling."
  },
  {
   "text": "Linear dose-response relationship",
   "target": "Vehicle Emissions",
   "rationale": "Surfaced by AttackThisModel: The model assumes a linear relationship between emission volumes and health outcomes. Epidemiological evidence suggests threshold effects and non-linear exposure-response curves, particularly for PM2.5 at low concentrations."
  },
  {
   "text": "Policy mandates are funded, not merely aspirational.",
   "target": "Transport Policy -> Green Infrastructure",
   "rationale": "Unfunded mandates rarely produce infrastructure on the ground."
  }
 ],
 "questions": [
  "Should we model seasonal variation in AQI?",
  "Is green infrastructure effect direct or mediated?",
  "Should we model non-linear dose-response for this pathway?",
  "[high] No evidence for the emission-to-AQ mechanism. — Suggested: Attach epidemiological study on PM2.5 pathways.",
  "[medium] Green Infrastructure effectiveness is assumed, not cited. — Suggested: Add urban ecology reference.",
  "urban air quality emissions dispersion ventilation dose-response meta-analysis\n\nWhy: Need empirical control for ventilation regimes."
 ],
 "challenges": [
  {
   "argument": "The assumed negative polarity (more emissions -> worse air quality) may be too simplistic. Wind patterns and atmospheric mixing can decouple local emissions from local concentrations.",
   "target": "Vehicle Emissions -> Air Quality Index"
  }
 ],
 "decisions": [
  {
   "statement": "Exclude industrial emissions from initial scope",
   "rationale": "Focus on transport for Phase 1; industrial sources added in Phase 2."
  },
  {
   "statement": "Keep as single composite index rather than per-pollutant",
   "rationale": "Per-pollutant split deferred to Phase 2.",
   "target": "Air Quality Index"
  }
